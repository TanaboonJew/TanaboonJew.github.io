---
// International Code of Signals flags, generated as SVG from each flag's
// heraldic blazon. No image assets — geometry only.
const RED = '#CE1126';
const BLUE = '#0052A5';
const YELLOW = '#FCD116';
const BLACK = '#16161A';
const WHITE = '#FFFFFF';

const rect = (fill: string) => `<rect width="100" height="70" fill="${fill}"/>`;
const box = (fill: string, x: number, y: number, w: number, h: number) =>
  `<rect x="${x}" y="${y}" width="${w}" height="${h}" fill="${fill}"/>`;
const poly = (points: string, fill: string) => `<polygon points="${points}" fill="${fill}"/>`;
const hstripe = (fill: string, y1: number, y2: number) => box(fill, 0, y1, 100, y2 - y1);

// Swallowtail: notch cut 36% into the fly, apex at mid-height.
const SWALLOW = 'M0,0 H100 L64,35 L100,70 H0 Z';

// Yankee: bendy sinister of ten or and gules — ten diagonal bands running
// upper-fly to lower-hoist, parameterized by t = x + y in [0, 170].
function seg(c: number): [string, string] {
  if (c <= 70) return [`${c},0`, `0,${c}`];
  if (c <= 100) return [`${c},0`, `${c - 70},70`];
  return [`100,${c - 100}`, `${c - 70},70`];
}
function yankeeBands(): string {
  const bands: string[] = [rect(RED)];
  for (let i = 0; i < 10; i += 2) {
    const [a1, b1] = seg(i * 17);
    const [a2, b2] = seg((i + 1) * 17);
    bands.push(poly(`${a1} ${b1} ${b2} ${a2}`, YELLOW));
  }
  return bands.join('');
}

function saltire(color: string): string {
  return `<path d="M-4,-4 L104,74 M104,-4 L-4,74" stroke="${color}" stroke-width="14"/>`;
}
function cross(color: string): string {
  return `${box(color, 43, 0, 14, 70)}${box(color, 0, 28, 100, 14)}`;
}

const inner: Record<string, string> = {
  A: `${box(WHITE, 0, 0, 50, 70)}${poly('50,0 100,0 64,35 100,70 50,70', BLUE)}`,
  B: `<path d="${SWALLOW}" fill="${RED}"/>`,
  C: [
    hstripe(BLUE, 0, 21),
    hstripe(WHITE, 21, 24.5),
    hstripe(RED, 24.5, 45.5),
    hstripe(WHITE, 45.5, 49),
    hstripe(BLUE, 49, 70),
  ].join(''),
  D: `${hstripe(YELLOW, 0, 23.34)}${hstripe(BLUE, 23.34, 46.67)}${hstripe(YELLOW, 46.67, 70)}`,
  E: `${hstripe(BLUE, 0, 35)}${hstripe(RED, 35, 70)}`,
  F: `${rect(WHITE)}${poly('50,0 100,35 50,70 0,35', RED)}`,
  G: Array.from({ length: 6 }, (_, i) =>
    box(i % 2 === 0 ? YELLOW : BLUE, i * (100 / 6), 0, 100 / 6 + 0.3, 70)
  ).join(''),
  H: `${box(WHITE, 0, 0, 50, 70)}${box(RED, 50, 0, 50, 70)}`,
  I: `${rect(YELLOW)}<circle cx="50" cy="35" r="15" fill="${BLACK}"/>`,
  J: `${hstripe(BLUE, 0, 23.34)}${hstripe(WHITE, 23.34, 46.67)}${hstripe(BLUE, 46.67, 70)}`,
  K: `${box(YELLOW, 0, 0, 50, 70)}${box(BLUE, 50, 0, 50, 70)}`,
  L: `${box(YELLOW, 0, 0, 50, 35)}${box(BLACK, 50, 0, 50, 35)}${box(BLACK, 0, 35, 50, 35)}${box(
    YELLOW,
    50,
    35,
    50,
    35
  )}`,
  M: `${rect(BLUE)}${saltire(WHITE)}`,
  N: Array.from({ length: 16 }, (_, i) => {
    const col = i % 4;
    const row = Math.floor(i / 4);
    return box((col + row) % 2 === 0 ? BLUE : WHITE, col * 25, row * 17.5, 25.3, 17.8);
  }).join(''),
  O: `${rect(RED)}${poly('0,0 0,70 100,70', YELLOW)}`,
  P: `${rect(BLUE)}${box(WHITE, 20, 19, 60, 32)}`,
  Q: rect(YELLOW),
  R: `${rect(RED)}${cross(YELLOW)}`,
  S: `${rect(WHITE)}${box(BLUE, 20, 19, 60, 32)}`,
  T: `${box(RED, 0, 0, 33.34, 70)}${box(WHITE, 33.34, 0, 33.33, 70)}${box(BLUE, 66.67, 0, 33.33, 70)}`,
  U: `${box(RED, 0, 0, 50, 35)}${box(WHITE, 50, 0, 50, 35)}${box(WHITE, 0, 35, 50, 35)}${box(
    RED,
    50,
    35,
    50,
    35
  )}`,
  V: `${rect(WHITE)}${saltire(RED)}`,
  W: `${rect(BLUE)}${box(WHITE, 7, 7, 86, 56)}${box(RED, 15, 15, 70, 40)}`,
  X: `${rect(WHITE)}${cross(BLUE)}`,
  Y: yankeeBands(),
  Z: `${rect(YELLOW)}${poly('0,0 50,35 0,70', BLACK)}${poly('0,70 50,35 100,70', RED)}${poly(
    '100,70 50,35 100,0',
    BLUE
  )}`,
};

interface FlagInfo {
  letter: string;
  name: string;
  meaning: string;
}

const ALPHABET: FlagInfo[] = (
  [
    ['A', 'Alfa', 'I have a diver down; keep well clear at slow speed.'],
    ['B', 'Bravo', 'I am taking in, discharging or carrying dangerous goods.'],
    ['C', 'Charlie', 'Affirmative.'],
    ['D', 'Delta', 'Keep clear of me; I am maneuvering with difficulty.'],
    ['E', 'Echo', 'I am altering my course to starboard.'],
    ['F', 'Foxtrot', 'I am disabled; communicate with me.'],
    ['G', 'Golf', 'I require a pilot.'],
    ['H', 'Hotel', 'I have a pilot on board.'],
    ['I', 'India', 'I am altering my course to port.'],
    ['J', 'Juliett', 'I am on fire and have dangerous cargo; keep well clear.'],
    ['K', 'Kilo', 'I wish to communicate with you.'],
    ['L', 'Lima', 'Stop immediately.'],
    ['M', 'Mike', 'My vessel is stopped and making no way through the water.'],
    ['N', 'November', 'Negative.'],
    ['O', 'Oscar', 'Man overboard.'],
    ['P', 'Papa', 'All persons report on board; the vessel is about to proceed to sea.'],
    ['Q', 'Quebec', 'My vessel is healthy and I request free pratique.'],
    ['R', 'Romeo', 'No ICS meaning as a single flag.'],
    ['S', 'Sierra', 'I am operating astern propulsion.'],
    ['T', 'Tango', 'Keep clear of me.'],
    ['U', 'Uniform', 'You are running into danger.'],
    ['V', 'Victor', 'I require assistance.'],
    ['W', 'Whiskey', 'I require medical assistance.'],
    ['X', 'Xray', 'Stop carrying out your intentions and watch for my signals.'],
    ['Y', 'Yankee', 'I am dragging my anchor.'],
    ['Z', 'Zulu', 'I require a tug.'],
  ] as [string, string, string][]
).map(([letter, name, meaning]) => ({ letter, name, meaning }));

const flagSvg = (info: FlagInfo) =>
  `<svg viewBox="0 0 100 70" role="img" aria-label="${info.name}: ${info.meaning}"><title>${info.name}</title>${inner[info.letter]}</svg>`;

const svgs: Record<string, string> = {};
for (const info of ALPHABET) svgs[info.letter] = flagSvg(info);

const escapeHtml = (s: string) =>
  s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
---

<div class="nf-tool">
  <div class="nf-head">
    <label class="nf-label" for="nf-input">Your message</label>
    <span class="nf-count" id="nf-count" aria-live="polite"></span>
  </div>
  <textarea id="nf-input" class="nf-input" rows="2" maxlength="120" spellcheck="false"
    autocomplete="off">BRAVO ZULU</textarea>
  <div class="nf-options">
    <label class="nf-check">
      <input type="checkbox" class="nf-labels-toggle" checked />
      <span>Show letters</span>
    </label>
    <button type="button" class="nf-clear">Clear</button>
  </div>
  <div class="nf-output" data-nf-output></div>
  <p class="nf-hint" data-nf-hint hidden>
    Nothing hoisted yet — type a message above.
  </p>
</div>

<h2>The full alphabet</h2>

<p>
  Every letter flag with its single-flag meaning at sea. Hover any flag for the story it tells on
  its own — the alphabet is only half the code.
</p>

<div class="nf-chart" data-nf-chart>
  {
    ALPHABET.map((info) => (
      <div class="nf-chart-tile" title={`${info.name} — ${info.meaning}`}>
        <span class="nf-cloth" set:html={flagSvg(info)} />
        <span class="nf-chart-cap">
          {info.letter} · {info.name}
        </span>
      </div>
    ))
  }
</div>

<script type="application/json" id="nf-flag-data" is:inline set:html={JSON.stringify(svgs)} />

<script>
  const dataEl = document.getElementById('nf-flag-data');
  const FLAGS: Record<string, string> = dataEl ? JSON.parse(dataEl.textContent || '{}') : {};

  function initTool(root: HTMLElement) {
    const input = root.querySelector<HTMLInputElement>('.nf-input');
    const output = root.querySelector<HTMLElement>('[data-nf-output]');
    const hint = root.querySelector<HTMLElement>('[data-nf-hint]');
    const count = root.querySelector<HTMLElement>('.nf-count');
    const labelsToggle = root.querySelector<HTMLInputElement>('.nf-labels-toggle');
    const clearBtn = root.querySelector<HTMLButtonElement>('.nf-clear');
    if (!input || !output || !labelsToggle) return;

    const esc = (s: string) =>
      s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');

    function render() {
      output!.classList.toggle('hide-labels', !labelsToggle!.checked);
      output!.replaceChildren();

      let word = document.createElement('div');
      word.className = 'nf-word';
      let letters = 0;

      const flush = () => {
        if (word.childElementCount > 0) output!.append(word);
      };

      for (const ch of input!.value.toUpperCase()) {
        if (/\s/.test(ch)) {
          flush();
          word = document.createElement('div');
          word.className = 'nf-word';
          continue;
        }
        letters++;
        const tile = document.createElement('div');
        tile.className = 'nf-tile';
        if (/[A-Z]/.test(ch)) {
          tile.classList.add('is-flag');
          tile.innerHTML = (FLAGS[ch] ?? '') + `<span class="nf-cap">${ch}</span>`;
        } else {
          tile.classList.add('is-mystery');
          tile.innerHTML = `<span class="nf-mystery">${esc(ch)}</span>`;
        }
        word.append(tile);
      }
      flush();

      if (hint) hint.hidden = letters > 0;
      if (count) count.textContent = `${letters} ${letters === 1 ? 'letter' : 'letters'}`;
    }

    input.addEventListener('input', render);
    labelsToggle.addEventListener('change', render);
    if (clearBtn)
      clearBtn.addEventListener('click', () => {
        input.value = '';
        render();
        input.focus();
      });
    render();
  }

  document.querySelectorAll<HTMLElement>('.nf-tool').forEach(initTool);
</script>

<style is:global>
  .nf-tool {
    margin: 1.4em 0 2em;
    padding: 24px;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 14px;
  }

  .nf-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 10px;
  }

  .nf-label {
    font-family: var(--font-mono);
    font-size: var(--size-meta);
    color: var(--muted);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .nf-count {
    font-family: var(--font-mono);
    font-size: var(--size-meta);
    color: var(--muted);
  }

  .nf-input {
    width: 100%;
    padding: 12px 14px;
    font-family: var(--font-mono);
    font-size: 15px;
    color: var(--text);
    background: transparent;
    border: 1px solid var(--border);
    border-radius: 10px;
    resize: vertical;
    min-height: 64px;
  }

  .nf-input:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  .nf-options {
    display: flex;
    align-items: center;
    gap: 18px;
    margin-top: 12px;
  }

  .nf-check {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    font-size: var(--size-small);
    color: var(--muted);
    cursor: pointer;
  }

  .nf-check input {
    accent-color: var(--accent);
    width: 15px;
    height: 15px;
    cursor: pointer;
  }

  .nf-clear {
    margin-left: auto;
    padding: 5px 12px;
    font-size: var(--size-small);
    color: var(--muted);
    background: transparent;
    border: 1px solid var(--border);
    border-radius: 999px;
    cursor: pointer;
    transition:
      color var(--speed-fast) ease,
      border-color var(--speed-fast) ease;
  }

  .nf-clear:hover {
    color: var(--text);
    border-color: var(--accent);
  }

  .nf-output {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    gap: 20px 30px;
    margin-top: 22px;
    min-height: 72px;
  }

  .nf-word {
    display: flex;
    align-items: flex-end;
    gap: 8px;
  }

  .nf-tile {
    width: clamp(44px, 8vw, 62px);
  }

  .nf-cloth,
  .nf-tile.is-flag svg {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 4px;
    box-shadow: 0 0 0 1px var(--border);
  }

  .nf-cap,
  .nf-chart-cap {
    display: block;
    margin-top: 6px;
    font-family: var(--font-mono);
    font-size: 11px;
    text-align: center;
    color: var(--muted);
  }

  .nf-output.hide-labels .nf-cap {
    display: none;
  }

  .nf-tile.is-mystery .nf-mystery {
    display: flex;
    align-items: center;
    justify-content: center;
    aspect-ratio: 10 / 7;
    font-family: var(--font-mono);
    font-size: 15px;
    color: var(--muted);
    border: 1.5px dashed var(--border);
    border-radius: 4px;
  }

  .nf-hint {
    margin: 14px 0 0;
    font-size: var(--size-small);
    color: var(--muted);
  }

  .nf-chart {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(88px, 1fr));
    gap: 14px;
    margin: 1.4em 0 1.8em;
  }

  .nf-chart-tile {
    text-align: center;
  }

  @media (max-width: 480px) {
    .nf-chart {
      grid-template-columns: repeat(auto-fill, minmax(72px, 1fr));
      gap: 10px;
    }
  }
</style>
